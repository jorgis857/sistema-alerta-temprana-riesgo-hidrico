# /etc/wrews/gateway.env  -  configuracion del gateway WREWS
# instalar.sh lo copia a /etc/wrews/gateway.env. Reemplace cada CAMBIAR_...
# Este archivo tiene claves: NO se sube al repositorio.
# Ojo: nada de comentarios al final de una linea (systemd los toma como valor).

# Identificador del equipo (igual a DEVICE_ID en el secrets.h del ESP32)
WREWS_DISPOSITIVO=wrews-01

# Broker local: Mosquitto en esta misma Pi, usuario "gateway"
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=gateway
MQTT_PASS=CAMBIAR_clave_del_usuario_gateway

# Base de datos
DB_PATH=/var/lib/wrews/wrews.db

# Procesamiento local: agregado (media/min/max) y envio a Ubidots cada
# VENTANA_S segundos; sin telemetria por SIN_DATOS_S segundos = FALLO de enlace
VENTANA_S=60
SIN_DATOS_S=20

# Ubidots. Si UBIDOTS_TOKEN queda vacio el gateway funciona solo local y los
# datos se acumulan en la cola de SQLite hasta que se configure.
# UBIDOTS_TLS=1 usa el puerto 8883 cifrado; 0 usa 1883 sin cifrar (solo si la
# red bloquea el 8883).
UBIDOTS_TOKEN=CAMBIAR_token_de_ubidots
UBIDOTS_DISPOSITIVO=wrews-01
UBIDOTS_HOST=industrial.api.ubidots.com
UBIDOTS_TLS=1
# Variables del agregado que se suben (estado, silenciado, gw_calidad e
# ia_min_critico van siempre). Con estas 5 son 10 variables en total
# contando "silenciar".
UBIDOTS_VARIABLES=nivel,riesgo,tasa,idx_evap,temp
# Mensajes por segundo al vaciar la cola despues de una caida de Internet
UBIDOTS_MSG_POR_S=2
# Enlace del tablero de Ubidots que manda el bot con /tablero (copiarlo de la
# barra del navegador con el tablero abierto). Pide iniciar sesion: sigue privado.
UBIDOTS_TABLERO_URL=

# Modulo de IA. IA_PROVEEDOR: claude | gemini | openai | ninguno
# (ninguno = solo la prediccion propia + recomendacion por reglas)
IA_PROVEEDOR=claude
# IA_LLM_AUTO=0: Claude solo se llama cuando alguien pide /recomendacion en
# Telegram (lo automatico usa la tabla de reglas, gratis). 1: tambien automatico.
IA_LLM_AUTO=0
ANTHROPIC_API_KEY=CAMBIAR_clave_de_la_api_de_anthropic
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFUERZO=low
# Alternativas (solo si cambian IA_PROVEEDOR)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
# Llamadas al LLM: siempre que cambia el estado (no mas de una cada
# IA_MIN_ENTRE_LLAMADAS_S s); ademas cada IA_CADA_S s en PRECAUCION/CRITICO
# y cada IA_CADA_S_NORMAL s en NORMAL. Regresion sobre IA_VENTANA_MIN minutos.
IA_CADA_S=300
IA_CADA_S_NORMAL=1800
IA_MIN_ENTRE_LLAMADAS_S=60
IA_VENTANA_MIN=10
IA_UMBRAL_CRITICO=15
IA_UMBRAL_PRECAUCION=50
IA_TIMEOUT_S=40

# Avisos al celular por Telegram (opcional, gratis). Crear el bot con
# @BotFather y pegar aqui su token. Acceso SOLO para personal autorizado:
# quien escribe /start queda pendiente hasta que el administrador
# (TELEGRAM_ADMIN = su chat id) responda /aprobar ID. El chat id del
# administrador se ve en el log del gateway cuando escribe /start.
# TELEGRAM_CLAVE (opcional): ademas exige "/start CLAVE".
# TELEGRAM_CHAT_ID (opcional): chats fijos extra, separados por coma.
TELEGRAM_TOKEN=
TELEGRAM_ADMIN=
TELEGRAM_CLAVE=
TELEGRAM_CHAT_ID=
